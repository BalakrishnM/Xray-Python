# Xray Cloud Integration - Environment Variables Template
#
# Copy this file to .env and fill in your credentials
# DO NOT commit .env file to version control!

# Xray Cloud API Credentials
# Get these from: Xray Cloud → Settings → API Keys → Create API Key
XRAY_CLIENT_ID=your-client-id-here
XRAY_CLIENT_SECRET=your-client-secret-here

# Jira Cloud Configuration
# Your Jira instance URL (no trailing slash)
JIRA_BASE_URL=https://yourcompany.atlassian.net

# Jira API Credentials
# Email: Your Jira account email
# Token: Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_USER_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token-here

# Xray Project Configuration
# The project key where Xray Tests will be created (e.g., "ABC", "PROJ")
XRAY_PROJECT_KEY=ABC

# Workflow Status Configuration
# Define the target status for Tests to be execution-ready
# Default workflow: Open > In Progress > Non GXP > Completed
# Target status should be the last status before "Completed" to allow execution
TEST_TARGET_STATUS=Non GXP

# Alternative execution-ready statuses (comma-separated, in priority order)
# These are acceptable statuses if the target status cannot be reached
# Example: "In Progress,Open" or "Ready,Approved,To Do"
TEST_EXECUTION_READY_STATUSES=In Progress,Open

# Blocked statuses that prevent test execution (comma-separated)
# Tests in these statuses cannot be included in Test Executions
TEST_BLOCKED_STATUSES=Completed,Done,Closed,Finished
